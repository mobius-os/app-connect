#!/usr/bin/env python3
"""mach — run work on one named Connect machine without shell-quoting puzzles.

The Connect app pairs external machines with this Möbius instance over a secure
outbound tunnel. `mach` sends ONE command to a NAMED machine and prints its raw
stdout/stderr, exiting with the remote exit code — so it reads like a local
shell, without the curl + JSON envelope.

Usage:
  mach -m <machine> '<command>'                 run one command on <machine>
  mach -m <machine> -C <absolute-dir> '<command>'
                                                run it from a remote directory
  mach -m <machine> --script [--shell <name>]   read a literal script from stdin
  mach -m <machine> -t <seconds> '<command>'    raise the timeout (default 60, max 3600)
  mach --list                                   list paired machines (name, status, id)

  <machine> matches a machine's name (case-insensitive substring) or its host id
  from `mach --list`. The target is ALWAYS explicit — even when only one machine
  is paired — so every command in the transcript records where it ran, and a
  second machine can never silently change what runs where.

  Keep a simple one-liner inline. For loops, JSON, templates, nested quotes, or
  several steps, send a literal script so the local shell cannot expand it:

      mach -m box -C /srv/app --script --shell bash <<'MACH'
      set -euo pipefail
      docker compose ps --format json
      MACH

  Script mode defaults to sh on POSIX and PowerShell on Windows. -C is passed
  directly to the remote runner, so use an absolute path. Every call remains
  self-contained: there is no remembered machine, directory, or environment.

Reads AGENT_TOKEN and API_BASE_URL from the environment.
"""
from __future__ import annotations

import json
import ntpath
import os
import posixpath
import secrets
import sys
import time
import urllib.error
import urllib.request


_MAX_COMMAND_CHARS = 64 * 1024
# Windows runners launch commands through cmd.exe, whose 8,191-character limit
# also includes its own wrapper text. Keep a small margin for that wrapper.
_MAX_WINDOWS_COMMAND_CHARS = 8_000
_DEFAULT_HTTP_TIMEOUT = 30
_MAX_HTTP_TIMEOUT = 3660


def _fail(msg: str, code: int = 1):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    raise SystemExit(code)


def _wait_to_retry(retry_until: float | None, delay: int) -> int | None:
    if retry_until is None:
        return None
    remaining = retry_until - time.monotonic()
    if remaining <= 0:
        return None
    time.sleep(min(delay, remaining))
    return min(delay * 2, 5)


def _call(
    path: str,
    payload=None,
    method: str = "GET",
    retry_until: float | None = None,
):
    base = os.environ.get("API_BASE_URL")
    token = os.environ.get("AGENT_TOKEN")
    if not base or not token:
        _fail("mach: API_BASE_URL / AGENT_TOKEN not set in this environment.")
    req = urllib.request.Request(
        base.rstrip("/") + path,
        data=json.dumps(payload).encode() if payload is not None else None,
        method=method,
    )
    req.add_header("Authorization", "Bearer " + token)
    if payload is not None:
        req.add_header("Content-Type", "application/json")
    delay = 1
    while True:
        try:
            request_timeout = _DEFAULT_HTTP_TIMEOUT
            if retry_until is not None:
                request_timeout = max(
                    1,
                    min(
                        _MAX_HTTP_TIMEOUT,
                        retry_until - time.monotonic(),
                    ),
                )
            with urllib.request.urlopen(req, timeout=request_timeout) as resp:
                try:
                    result = json.loads(resp.read().decode())
                except (UnicodeError, ValueError):
                    _fail("mach: Möbius returned an invalid response.", 2)
                if not isinstance(result, dict):
                    _fail("mach: Möbius returned an invalid response.", 2)
                return result
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode(errors="replace")
            if exc.code in (502, 503):
                next_delay = _wait_to_retry(retry_until, delay)
                if next_delay is not None:
                    delay = next_delay
                    continue
            try:
                parsed = json.loads(detail)
                if isinstance(parsed, dict) and parsed.get("detail"):
                    detail = parsed["detail"]
            except ValueError:
                pass
            _fail(f"mach: {detail}", 2)
        except (urllib.error.URLError, TimeoutError) as exc:
            next_delay = _wait_to_retry(retry_until, delay)
            if next_delay is not None:
                delay = next_delay
                continue
            reason = (
                exc.reason
                if isinstance(exc, urllib.error.URLError)
                else "request timed out"
            )
            _fail(f"mach: could not reach Möbius ({reason}).", 2)


def _hosts():
    return _call("/api/connect/hosts").get("hosts", [])


def _format(hosts) -> str:
    rows = []
    for h in hosts:
        state = "online" if h.get("online") else (
            "offline" if h.get("paired") else "waiting to pair")
        rows.append(f"  {h['name']}  ({state})  [{h['id']}]")
    return "\n".join(rows) or "  (no machines paired yet — open the Connect app)"


def _matches(hosts, machine):
    exact = [host for host in hosts if host.get("id") == machine]
    if exact:
        return exact
    needle = machine.lower()
    return [
        host for host in hosts
        if needle in (host.get("name") or "").lower()
    ]


def _is_windows(platform_name: str | None) -> bool:
    return (platform_name or "").lower().startswith("windows")


def _windows_command_units(command: str) -> int:
    return len(command.encode("utf-16-le", errors="surrogatepass")) // 2


def _is_absolute_remote_path(path: str, platform_name: str | None) -> bool:
    if not _is_windows(platform_name):
        return posixpath.isabs(path)
    drive, tail = ntpath.splitdrive(path)
    return bool(drive) and tail.startswith(("\\", "/"))


def _selected_script_shell(
    shell: str | None, platform_name: str | None,
) -> str:
    """Resolve the remote interpreter and reject unsupported Windows shells."""
    if _is_windows(platform_name):
        executable = shell or "powershell.exe"
        allowed = {
            "powershell": "powershell.exe",
            "powershell.exe": "powershell.exe",
            "pwsh": "pwsh",
            "pwsh.exe": "pwsh.exe",
        }
        executable = allowed.get(executable.lower())
        if executable is None:
            _fail(
                "mach: Windows script mode supports powershell or pwsh; "
                "use a plain command for cmd.exe."
            )
        return executable
    return shell or "sh"


def _read_script() -> str:
    script = sys.stdin.read(_MAX_COMMAND_CHARS + 1)
    if not script.strip():
        _fail("mach: --script received no script on stdin.")
    if "\x00" in script:
        _fail("mach: a script cannot contain a NUL byte.")
    if len(script) > _MAX_COMMAND_CHARS:
        _fail(
            "mach: the remote work is larger than 64 KiB; split the work "
            "or place a script in the project first."
        )
    return script


def main(argv) -> int:
    machine = None
    timeout = 60
    cwd = None
    script_mode = False
    shell = None
    cmd_parts: list[str] = []
    it = iter(argv)
    for tok in it:
        if tok in ("-m", "--machine"):
            machine = next(it, None)
            if not machine:
                _fail("mach: -m / --machine needs a machine name.")
        elif tok in ("-t", "--timeout"):
            raw_timeout = next(it, None)
            try:
                timeout = int(raw_timeout)
            except (TypeError, ValueError):
                _fail("mach: timeout must be a whole number from 1 to 3600 seconds.")
            if not 1 <= timeout <= 3600:
                _fail("mach: timeout must be a whole number from 1 to 3600 seconds.")
        elif tok in ("-C", "--cwd"):
            cwd = next(it, None)
            if not cwd:
                _fail("mach: -C / --cwd needs an absolute remote directory.")
        elif tok == "--script":
            script_mode = True
        elif tok == "--shell":
            shell = next(it, None)
            if not shell:
                _fail("mach: --shell needs an executable name such as sh or bash.")
        elif tok == "--list":
            print(_format(_hosts()))
            return 0
        elif tok in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            cmd_parts.append(tok)
            cmd_parts.extend(it)

    if machine is None:
        _fail("mach: name a machine with -m <machine>. Paired machines:\n"
              + _format(_hosts()))
    if script_mode and cmd_parts:
        _fail("mach: --script reads stdin; do not also provide an inline command.")
    if shell is not None and not script_mode:
        _fail("mach: --shell is only used with --script.")
    if not script_mode and not cmd_parts:
        _fail(
            "mach: nothing to run. Use '<command>' or pipe a literal script "
            "with --script."
        )

    hosts = _hosts()
    matches = _matches(hosts, machine)
    if not matches:
        _fail(f"mach: no paired machine matches '{machine}'. Paired machines:\n"
              + _format(hosts))
    if len(matches) > 1:
        _fail(f"mach: '{machine}' is ambiguous — it matches:\n" + _format(matches))
    host = matches[0]
    if not host.get("online"):
        _fail(f"mach: {host['name']} is offline right now.")
    if cwd is not None and not _is_absolute_remote_path(
        cwd, host.get("platform"),
    ):
        _fail(
            "mach: -C / --cwd must be an absolute path on the remote machine."
        )

    if script_mode:
        script = _read_script()
        command = None
    else:
        command = " ".join(cmd_parts)
    if (
        command is not None
        and _is_windows(host.get("platform"))
        and _windows_command_units(command) > _MAX_WINDOWS_COMMAND_CHARS
    ):
        _fail(
            "mach: the remote command is too large for the Windows shell; "
            "split the work or place a script in the project first."
        )
    if command is not None and len(command) > _MAX_COMMAND_CHARS:
        _fail(
            "mach: the remote work is larger than 64 KiB; split the work "
            "or place a script in the project first."
        )

    request_id = secrets.token_hex(8)
    payload = {"timeout": timeout, "request_id": request_id}
    if script_mode:
        # The current runner carries the exact script as data. It never becomes
        # a local or remote command-line argument, avoiding quoting and OS limits.
        payload["script"] = script
        if shell is not None:
            payload["shell"] = _selected_script_shell(
                shell, host.get("platform"),
            )
    else:
        payload["cmd"] = command
    if cwd is not None:
        payload["cwd"] = cwd
    try:
        res = _call(
            f"/api/connect/hosts/{host['id']}/exec",
            payload,
            "POST",
            time.monotonic() + timeout + 75,
        )
    except KeyboardInterrupt:
        try:
            _call(
                f"/api/connect/hosts/{host['id']}/commands/{request_id}/cancel",
                {}, "POST",
            )
            sys.stderr.write(
                f"\nmach: asked {host['name']} to stop the command.\n"
            )
        except SystemExit:
            sys.stderr.write(
                "mach: stopped waiting, but remote cancellation was not "
                "confirmed. Check Connect before sending another command.\n"
            )
        return 130
    stdout = res.get("stdout", "")
    stderr = res.get("stderr", "")
    exit_code = int(res.get("exit_code", 0))
    sys.stdout.write(stdout)
    sys.stderr.write(stderr)
    if res.get("truncated"):
        sys.stderr.write("\nmach: output was truncated by Möbius.\n")
    if exit_code and not stdout and not stderr:
        sys.stderr.write(
            f"mach: remote command exited {exit_code} without producing output.\n"
        )
    return exit_code


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
